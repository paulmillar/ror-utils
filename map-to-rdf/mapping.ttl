# RML mapping for ROR data dumps using ROR Schema v2 (v2.0 / v2.1).
#
# Run with
#
#  RMLMapper -f functions.ttl -o output.ttl -s turtle -m mapping.ttl
#
# Schema v2 changes handled here (compared to the v1 mapping):
#   * name/aliases/acronyms/labels  -> single 'names' array with 'types'
#   * addresses/country             -> 'locations[].geonames_details'
#   * external_ids object (GRID, ISNI, ...) -> array of {type, all, preferred}
#     with lower-case types; HESA, UCAS, CNRS, OrgRef and UKPRN no longer exist
#   * links / wikipedia_url         -> 'links' array of {type, value}
#   * types and relationship types are now lower-case
#
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix s: <http://schema.org/> .
@prefix grid: <http://www.grid.ac/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vivo: <http://vivoweb.org/ontology/core#> .
@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix ref:  <https://github.com/paulmillar/rml-extra-functions#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix geosparql:  <http://www.opengis.net/ont/geosparql#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@base <http://example.com/base/> .

##
##  ADDRESSES
##

<AddressMap> a rr:TriplesMap;
  rml:logicalSource [
    #rml:source "test-data.json";
    rml:source "latest-ror-data.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.[*]"
  ];

  rr:subjectMap [
    rr:class grid:Address ;

    fnml:functionValue [
      rr:predicateObjectMap [
        rr:predicate fno:executes ;
        rr:object ref:resolveDirectory ] ;
      rr:predicateObjectMap [
        rr:predicate ref:p_string_base_uri ;
        rr:objectMap [ rml:reference "id" ] ] ;
      rr:predicateObjectMap [
        rr:predicate ref:p_string_path ;
        rr:object "address-0" ]
    ];
    rr:termType rr:IRI
  ];

  rr:predicateObjectMap [
    rr:predicate owl:sameAs;
    rr:objectMap [
      rr:termType rr:IRI;
      rr:template "http://www.grid.ac/institutes/{external_ids[?(@.type==\"grid\")].preferred}/address-0"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:countryCode;
    rr:objectMap [ rml:reference "locations[0].geonames_details.country_code" ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:countryName;
    rr:objectMap [ rml:reference "locations[0].geonames_details.country_name" ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasGeonamesCity;
    rr:objectMap [
      rr:termType rr:IRI;
      rr:template "https://sws.geonames.org/{locations[0].geonames_id}/"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate geo:lat;
    rr:objectMap [
      rr:datatype xsd:float;
      rml:reference "locations[0].geonames_details.lat"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate geo:long;
    rr:objectMap [
      rr:datatype xsd:float;
      rml:reference "locations[0].geonames_details.lng"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:cityName;
    rr:objectMap [
      rml:reference "locations[0].geonames_details.name"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate geosparql:asWKT;
    rr:objectMap [
      rr:termType rr:Literal;
      rr:datatype geosparql:wktLiteral;
      rr:template "POINT({locations[0].geonames_details.lng} {locations[0].geonames_details.lat})"
    ]
  ].


##
##  ORGANISATIONS
##

<OrganisationMap> a rr:TriplesMap;

  rml:logicalSource [
    #rml:source "test-data.json";
    rml:source "latest-ror-data.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.[*]"
  ];

  #
  # Subject and Type
  #
  rr:subjectMap [
    rml:reference "id";
    rr:class foaf:Organization
  ];

  # Organisation types (rdf:type grid:Education etc.) are mapped by the
  # per-type TriplesMaps at the end of this file.

  #
  # Explicit link to GRID
  #
  rr:predicateObjectMap [
    rr:predicate owl:sameAs;
    rr:objectMap [
      rr:termType rr:IRI;
      rr:template "http://www.grid.ac/institutes/{external_ids[?(@.type==\"grid\")].preferred}"
    ]
  ];

  #
  # Names and aliases.
  #
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel;
    rr:predicate rdfs:label;
    rr:predicate s:name;
    rr:objectMap [
      rml:reference "names[?(@.types anyof ['ror_display'])].value"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate skos:altLabel;
    rr:predicate rdfs:label;
    rr:predicate s:alternateName;
    rr:objectMap [
      rml:reference "names[?(@.types anyof ['alias'])].value"
    ]
  ];

  # label (other than the display name) -> names in other languages
  rr:predicateObjectMap [
    rr:predicate skos:altLabel;
    rr:predicate rdfs:label;
    rr:predicate s:alternateName;
    rr:objectMap [
      rml:reference "names[?(@.types anyof ['label'] && @.types noneof ['ror_display'])].value"
    ]
  ];

  # acronym
  rr:predicateObjectMap [
    rr:predicate vivo:abbreviation;
    rr:objectMap [
      rml:reference "names[?(@.types anyof ['acronym'])].value"
    ]
  ];

  #
  #  Significant dates.
  #
  rr:predicateObjectMap [
    rr:predicate grid:establishedYear;
    rr:objectMap [
      rr:datatype xsd:gYear;
      rml:reference "established"
    ]
  ];


  #
  #   Location information.
  #
  rr:predicateObjectMap [
    rr:predicate grid:hasAddress;

    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:object ref:resolveDirectory ] ;
        rr:predicateObjectMap [
          rr:predicate ref:p_string_base_uri ;
          rr:objectMap [ rml:reference "id" ] ] ;
        rr:predicateObjectMap [
          rr:predicate ref:p_string_path ;
          rr:object "address-0" ]
      ];
      rr:termType rr:IRI
    ]
  ];

  #
  # Various IDs.
  #
  # v2 'external_ids' is an array of {type, all, preferred}; allowed
  # types are fundref, grid, isni and wikidata.  The v1-only HESA, UCAS,
  # CNRS, OrgRef and UKPRN identifiers were dropped by ROR.
  #
  # TODO: add the ROR id.
  #
  rr:predicateObjectMap [
    rr:predicate grid:isni;
    rr:objectMap [
      rml:reference "external_ids[?(@.type==\"isni\")].all[*]"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:crossrefFunderId;
    rr:objectMap [
      rml:reference "external_ids[?(@.type==\"fundref\")].all[*]"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasWikidataId;
    rr:objectMap [
      rr:termType rr:IRI;
      rr:template "http://www.wikidata.org/entity/{external_ids[?(@.type==\"wikidata\")].all[*]}"
    ]
  ];

  # Not actively curated
  rr:predicateObjectMap [
    rr:predicate grid:id;
    rr:objectMap [
      rml:reference "external_ids[?(@.type==\"grid\")].preferred"
    ]
  ];


  #
  # Relationships to other organisations.
  #
  # v2 relationship types are lower-case: related, parent, child,
  # predecessor, successor.  (The GRID-era "Other" type is gone.)
  #
  rr:predicateObjectMap [
    rr:predicate grid:hasRelated;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "relationships[?(@.type==\"related\")].id"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasChild;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "relationships[?(@.type==\"child\")].id"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasParent;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "relationships[?(@.type==\"parent\")].id"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasPredecessor;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "relationships[?(@.type==\"predecessor\")].id"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate grid:hasSuccessor;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "relationships[?(@.type==\"successor\")].id"
    ]
  ];

  # v2 values: active, inactive, withdrawn
  rr:predicateObjectMap [
    rr:predicate grid:status;
    rr:objectMap [
      rml:reference "status"
    ]
  ];

  #
  # Links to web pages.
  #
  # v2: 'wikipedia_url' and 'links' are merged into a single 'links'
  # array of {type, value} with type 'website' or 'wikipedia'.  Missing
  # links are simply absent, so the old 'emptyToNull' workaround for
  # empty wikipedia_url strings is no longer needed.
  #
  rr:predicateObjectMap [
    rr:predicate grid:wikipediaPage;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "links[?(@.type==\"wikipedia\")].value"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate foaf:homepage;
    rr:objectMap [
      rr:termType rr:IRI;
      rml:reference "links[?(@.type==\"website\")].value"
    ]
  ].


##
##  ORGANISATION TYPES
##
##  v2 types are lower-case (education, funder, healthcare, company,
##  archive, nonprofit, government, facility, other), whereas the GRID
##  ontology classes are title-case.  One TriplesMap per type selects the
##  matching records and asserts the corresponding class.
##  Note: 'funder' is new in ROR and has no GRID equivalent.
##

<TypeEducationMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "latest-ror-data.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$[?(@.types anyof ['education'])]"
  ];
  rr:subjectMap [
    rml:reference "id";
    rr:class grid:Education
  ].

<TypeFunderMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "latest-ror-data.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$[?(@.types anyof ['funder'])]"
  ];
  rr:subjectMap [
    rml:reference "id";
    rr:class grid:Funder
  ].

